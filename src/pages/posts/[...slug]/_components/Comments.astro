---
/**
 * Giscus comments (giscus.app) — plain-script embed with theme sync.
 *
 * No framework: giscus's React wrapper was only ever a convenience around
 * the iframe postMessage API used below. Comment threads live in GitHub
 * Discussions on charles-hood/cdh-astro-blog (the v5 repo), keyed by
 * pathname, so all existing threads carry over unchanged.
 */
---

<div id="giscus-comments" class="mt-2"></div>

<script>
  const GISCUS_ORIGIN = "https://giscus.app";

  const GISCUS_CONFIG: Record<string, string> = {
    "data-repo": "charles-hood/cdh-astro-blog",
    "data-repo-id": "R_kgDOPTXr4Q",
    "data-category": "Announcements",
    "data-category-id": "DIC_kwDOPTXr4c4Ctc6B",
    "data-mapping": "pathname",
    "data-strict": "0",
    "data-reactions-enabled": "1",
    "data-emit-metadata": "0",
    "data-input-position": "bottom",
    "data-lang": "en",
    "data-loading": "lazy",
  };

  function currentTheme(): string {
    return document.documentElement.getAttribute("data-theme") === "dark"
      ? "dark"
      : "light";
  }

  function mount(): void {
    const container = document.getElementById("giscus-comments");
    if (!container || container.hasChildNodes()) return;

    const script = document.createElement("script");
    script.src = `${GISCUS_ORIGIN}/client.js`;
    script.async = true;
    script.crossOrigin = "anonymous";
    for (const [key, value] of Object.entries(GISCUS_CONFIG)) {
      script.setAttribute(key, value);
    }
    script.setAttribute("data-theme", currentTheme());
    container.appendChild(script);
  }

  // giscus loads lazily: its iframe exists before it has loaded giscus.app,
  // and a message sent then is dropped (with a console warning). So only
  // message a frame once it has spoken to us, and on its first message send
  // the current theme, in case the reader toggled before it loaded.
  const readyFrames = new WeakSet<Window>();

  function giscusFrame(): HTMLIFrameElement | null {
    return document.querySelector<HTMLIFrameElement>("iframe.giscus-frame");
  }

  function syncTheme(): void {
    const target = giscusFrame()?.contentWindow;
    if (!target || !readyFrames.has(target)) return;
    target.postMessage(
      { giscus: { setConfig: { theme: currentTheme() } } },
      GISCUS_ORIGIN
    );
  }

  window.addEventListener("message", event => {
    if (event.origin !== GISCUS_ORIGIN) return;
    const target = giscusFrame()?.contentWindow;
    if (!target || event.source !== target || readyFrames.has(target)) return;
    readyFrames.add(target);
    syncTheme();
  });

  // The site's theme.ts reflects every toggle onto <html data-theme="...">;
  // watching that attribute keeps the giscus iframe in step. documentElement
  // survives View Transitions, so one observer is enough for the session.
  new MutationObserver(syncTheme).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });

  // Mount on astro:page-load, which fires on the first load and after every
  // View Transitions navigation (the container arrives empty). Not on
  // astro:after-swap: theme.ts restores data-theme in its own after-swap
  // handler, and mounting before it ran loaded giscus in the light theme on a
  // dark page.
  document.addEventListener("astro:page-load", mount);
</script>
